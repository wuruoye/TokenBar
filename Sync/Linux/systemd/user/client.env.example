# Install as ~/.config/tokenbar-sync/client.env with mode 0600.
TOKENBAR_SYNC_URL=http://127.0.0.1:18765
TOKENBAR_SYNC_TOKEN=use-the-same-long-random-shared-token
TOKENBAR_SYNC_DEVICE_NAME=Linux server
TOKENBAR_STATISTICS_TIMEZONE=utc
# Set TOKENBAR_STATISTICS_TIMEZONE=local only when every merging client uses local statistics.
# TOKENBAR_ACTIVITY_SNAPSHOT may point to a helper-produced snapshot instead of running the helper.
# TOKENBAR_SYNC_DEVICE_ID is optional; a stable UUID is generated on first run.
